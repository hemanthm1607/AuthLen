# ==============================================================================
# AuthLens Environment Variables (Local & Vercel Deployment)
# ==============================================================================

# --- Application & Environment ---
NODE_ENV=production
# In local dev: http://localhost:5173. On Vercel: https://your-project.vercel.app (or left blank for automatic detection)
FRONTEND_URL=https://your-project.vercel.app

# --- Database Connection (PostgreSQL) ---
# Option A: Cloud Connection String (Recommended for Vercel, Neon, Supabase, Vercel Postgres)
DATABASE_URL=postgres://user:password@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require
# Alternative connection string alias supported:
# POSTGRES_URL=postgres://user:password@ep-xyz.us-east-1.aws.neon.tech/neondb?sslmode=require

# Option B: Individual PostgreSQL Credentials (for local development or custom servers)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=authlens_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_SSL=false

# --- Session Security ---
# Generate a cryptographically secure 64-char hex key:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=generate_a_strong_random_secret_string_here

# --- AI Remediation Service ---
# Provider options: gemini | openai | mock
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Optional OpenAI configuration:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini

# --- Rate Limiting (SEC-001) ---
LOGIN_RATE_LIMIT_WINDOW_MS=900000
LOGIN_RATE_LIMIT_MAX=5

# --- Optional Frontend Environment Variables ---
# Set only if frontend is hosted on a completely separate domain from the backend.
# If frontend and backend are both on Vercel, leave empty so requests call same-origin /api/...
# VITE_API_URL=

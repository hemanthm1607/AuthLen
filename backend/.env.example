# Server Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=authlens_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# Session Configuration
# Generate a cryptographically random string (e.g., node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=your_secure_random_session_secret_change_in_production

# Email Service Configuration (for password reset and email verification)
# Options: console | smtp
EMAIL_PROVIDER=console
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@authlens.dev

# Rate Limiting Configuration (SEC-001)
# Time window in milliseconds for login attempts (default: 15 minutes = 900000 ms)
LOGIN_RATE_LIMIT_WINDOW_MS=900000
# Maximum failed attempts allowed from an IP within the window before receiving HTTP 429 (default: 5)
LOGIN_RATE_LIMIT_MAX=5

# AI Recommendations Provider Configuration
# Supported providers: gemini | openai
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# Alternative OpenAI Configuration:
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini


